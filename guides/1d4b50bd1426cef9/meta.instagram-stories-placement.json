    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Instagram Stories is a placement you can choose for your Meta ads, so your creative runs in the full-screen Stories format. It is a delivery location, not an audience or targeting control, and it is one of several placements you can pick.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Choose your ad placement: 'Instagram Stories'",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta lists it alongside Instagram feed, Instagram Reels, Instagram Explore home and the Facebook and Messenger placements.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Choose a placement",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Instagram Stories supports image, video, carousel and collection ads, according to Meta's placement format table.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.placement_objectives",
                "source_url": "https://www.facebook.com/business/help/279271845888065",
                "locator": "Stories, status and reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available ad placements for marketing objectives",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Which objectives are available depends on the placement and format you choose. Meta's ads guide asks you to select a placement to see the objectives it supports.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Choose a placement",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "If you boost a story from Business Suite, boosting the Instagram story or its Facebook counterpart lets the ad run on whichever of those platforms you choose. You do not need to boost both.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.stories",
                "source_url": "https://www.facebook.com/business/help/190599608272281",
                "locator": "Create ads in stories using Business Suite mobile app",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ads in Stories",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Use it when your creative suits a full-screen, vertical, story-style format and you want a dedicated Instagram Stories slot, for example to run image, video, carousel or collection ads there.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.placement_objectives",
                "source_url": "https://www.facebook.com/business/help/279271845888065",
                "locator": "Stories, status and reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available ad placements for marketing objectives",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your campaign objective or format may not be supported there. Check the objectives available for the placement first. Do not assume it restricts delivery on its own, because it is one placement choice among many.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Choose a placement",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },

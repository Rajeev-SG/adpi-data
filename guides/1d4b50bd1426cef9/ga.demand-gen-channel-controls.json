    "sections": [
      {
        "kind": "definition",
        "summary": "Channel controls are a Demand Gen setting that decides which Google surfaces your ads can appear on.",
        "status": "documented",
        "claims": [
          {
            "text": "Channel controls in Demand Gen campaigns let you choose where your ads appear across Google's visual-first surfaces, including YouTube, Gmail, Discover, Maps, and the Google Display Network.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "What are channel controls?",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The control is set at the ad group level, so different ad groups within the same campaign can serve on different channels.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "How to use channel controls in Demand Gen",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For example, you can tailor a campaign to serve specifically on YouTube Shorts.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "What are channel controls?",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "Controls are applied per ad group, with a manual selection option and an automatic all-channels option.",
        "status": "documented",
        "claims": [
          {
            "text": "You can either select channels manually for an ad group or choose All Google channels to let Google set them automatically.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "How to use channel controls in Demand Gen",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Google states that its system is designed to achieve the best possible results by using all channels and available ad inventory, and recommends All Google channels for most advertisers because it supports efficient budget allocation and cost control.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "How to use channel controls in Demand Gen",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "A stated benefit is channel-level performance transparency: you can check a detailed performance breakdown by channel and use it to inform optimization decisions.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "What are channel controls?",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Not all channels are compatible with every ad type or audience, so available options depend on your ad format and audience settings.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "applicable condition",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "Best suited to strategies that need a specific surface or want to extend a social approach onto Google; less suited when maximum reach matters most.",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you have format-specific creative, such as vertical video, and want it to show on a specific surface like YouTube Shorts for an optimal mobile experience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "What are channel controls?",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Use it when you want to extend a social strategy onto YouTube, including YouTube Shorts, beyond paid social platforms.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "What are channel controls?",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your priority is maximum reach and you have no surface-specific constraints: the source explicitly recommends all-channel selection for most advertisers, and restricting channels can only reduce available inventory.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "How to use channel controls in Demand Gen",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "What are channel controls?",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your ad type or audience is incompatible with your intended channels; Google Ads states channel compatibility varies by ad type and audience.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "applicable condition",

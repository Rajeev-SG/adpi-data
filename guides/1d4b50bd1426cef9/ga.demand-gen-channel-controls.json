                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Channel controls are configured within the Demand Gen ad group settings; only the ad-group-level location and the manual vs. automatic choice are documented.",
        "status": "documented",
        "claims": [
          {
            "text": "In a Demand Gen campaign, open an ad group and find the Channel controls setting.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",

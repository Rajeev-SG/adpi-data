                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choose either manual channel selection or All Google channels for that ad group.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",
                "locator": "How to use channel controls in Demand Gen",
                "source_site": "Google Ads Help",
                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Check channel compatibility with your ad type and audience before selecting channels, since not all channels work with every ad type or audience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.demand_gen.channels",
                "source_url": "https://support.google.com/google-ads/answer/15973205?hl=en",

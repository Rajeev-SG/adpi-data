    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Awareness is the Meta campaign objective for building reach and recall rather than driving a click or purchase. You choose it at campaign level, and the performance goal you pick later decides what Meta actually optimises for.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": "Campaign level in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "Recreate a campaign that used an original ad objective in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It is one of six objectives in Ads Manager: Awareness, Traffic, Engagement, Leads, App promotion and Sales. It is supported for image ads.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Supported objectives",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Your objective choice determines which placements and calls to action are available for the ad.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Supported objectives: 'Awareness'",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Awareness takes no conversion location selection (the location is on your ad) and needs no conversion event.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": "Awareness",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta maps older objectives onto Awareness through a performance goal: Ad recall lift (from Brand awareness), Reach or impressions (from Reach), and ThruPlay or 2-second continuous video views (from Video views). Store traffic maps to Awareness with Store locations features turned on, only for Pages with store locations set up.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "Recreate a campaign that used an original ad objective in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when your current goal is building awareness and reaching new people, for example ad recall, reach, or video views, rather than a purchase or sign-up.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "(none)",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you need purchases, leads or other conversions. Awareness has no conversion event, so Meta is not told to optimise for those actions; Sales or Leads fit better.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": "Awareness",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Use it to recreate older Brand awareness, Reach, Video views or Store traffic campaigns now that those objectives no longer exist.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "Recreate a campaign that used an original ad objective in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },

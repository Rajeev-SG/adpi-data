      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Conversion rate and CPA: if people who visited key pages are more likely to convert than cold traffic, targeting them may raise conversion rate and lower CPA. The trade-off is a small, fast-saturating audience, so frequency rises and reach is capped.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.custom_audiences.website.about",
                "source_url": "https://www.facebook.com/business/help/610516375684216",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About Website Custom Audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Reported conversions: a retargeting audience can attribute sales that would have happened anyway, so attributed results may overstate incremental impact. Use holdout or exclusion tests before crediting it with new demand.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.website_audience",
                "source_url": "https://www.facebook.com/business/help/1474662202748341",

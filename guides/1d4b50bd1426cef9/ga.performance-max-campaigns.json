      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Because Smart Bidding auctions in real time on conversion probability against your optional ROAS or CPA target, a useful metric to track is conversion value divided by cost (or cost per conversion) at the campaign level, so you can see whether the bidding target is achievable and whether budget shifts toward inventory that converts. Trade-off: a stricter target constrains bidding and may reduce reach, while a looser target may raise spend.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",
                "locator": "How Performance Max works",
                "source_site": "Google Ads Help",
                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": [
              "Holds only if conversions are measured consistently and the optional ROAS/CPA target is set appropriately",
              "Ad Grants-funded accounts may not serve on all inventory, so volume comparisons against full-inventory advertisers can mislead"
            ]
          },
          {
            "text": "Reported conversions here are attributed outcomes, not proof of incremental lift; Google Ads publishes no uplift figures, so treat any uplift expectation as conditional on your own testing.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",

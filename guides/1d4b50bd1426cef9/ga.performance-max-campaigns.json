      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Performance Max is a goal-based campaign type in Google Ads that reaches all Google Ads inventory — YouTube, Display, Search, Discover, Gmail, and Maps — from a single campaign.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",
                "locator": "Performance Max is a goal-based campaign type that allows you to access all Google Ads inventory, including YouTube, Display, Search, Discover, Gmail, and Maps, from a single campaign.",
                "source_site": "Google Ads Help",
                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Google positions it as a complement to keyword-based Search campaigns, used to optimize performance toward specific goals and find additional conversions and value.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",
                "locator": "About Performance Max campaigns",
                "source_site": "Google Ads Help",
                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Campaigns run through Google Ad Grants may not be eligible to serve on all inventory.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",
                "locator": "applicable condition (eligibility)",
                "source_site": "Google Ads Help",
                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "The advertiser supplies assets and settings (images, data feeds, bidding goals) and Google AI combines them to serve across all available inventory and automatically optimize toward the stated goals.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",
                "locator": "How Performance Max works",
                "source_site": "Google Ads Help",
                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Conversion goals and values: you define which conversion actions matter and can assign an optional ROAS or CPA target; Smart Bidding then bids in real-time auctions based on conversion probability.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",
                "locator": "How Performance Max works",
                "source_site": "Google Ads Help",
                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Creative assets: you provide text, images, and videos, and generative AI tools can combine those assets to produce new images and videos.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",
                "locator": "How Performance Max works",
                "source_site": "Google Ads Help",
                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Audience signals are intent preferences you share to guide learning; Google AI uses high-intent audiences to accelerate campaign learning.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",
                "locator": "How Performance Max works",
                "source_site": "Google Ads Help",
                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Budget and safety: you set daily spend targets and brand safety settings (brand exclusions, placement exclusions, content suitability filters), and the system automatically funnels budget toward the highest-performing inventory and placements.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.pmax.overview",
                "source_url": "https://support.google.com/google-ads/answer/10724817?hl=en",

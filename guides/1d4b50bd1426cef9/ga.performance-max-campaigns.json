                "source_title": "About Performance Max campaigns",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when full inventory reach matters and your account is funded through Google Ad Grants, since such campaigns may not be eligible to serve on all inventory.",

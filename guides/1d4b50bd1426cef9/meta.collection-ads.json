  "guide": {
    "feature_id": "meta.collection-ads",
    "name": "Collection ads",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.ads.guide.collection.collection-ad-format"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Collection ads pair a cover image or video with product images and open a full-screen Instant Experience when tapped. The Instant Experience is mandatory, so build it before the ad.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Facebook Feed",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In Facebook Feed, the ad shows a cover image or video followed by three product images. The cover image or video uses the first media asset from your Instant Experience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Facebook Feed",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It is a creative format, not an audience or bidding control. It changes what people see and where they land, not who is targeted.",
            "status": "inferred",
            "evidence": [],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Tapping the cover image or video on mobile opens a full-screen Instant Experience where people can discover, browse and buy products.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Tapping one of the smaller product images opens a product page that you provide, which pushes people towards purchase.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "You can build the Instant Experience from the Storefront, Lookbook or Customer Acquisition templates, or make a custom one.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Facebook Feed",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "You set it at ad level. The objective is set at campaign level, and audience, placement and budget are shared at ad set level.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you sell a range of products or services to mobile shoppers and want people to browse a visual, full-screen experience before reaching a product page.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Facebook Feed",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you cannot build or maintain an Instant Experience, or have no product pages to link to. The Instant Experience and a landing page URL are both required.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Technical requirements",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The Format option in Ad setup may no longer list collection for you. You can still select it in Ad creative under Format display options, so do not assume it has been withdrawn.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "The documented path covers the main steps. The Conversion options, template list and Ad creative fields are not itemised by Meta, so the steps stop there.",
        "status": "documented",
        "claims": [
          {
            "text": "Open Meta Ads Manager and click + Create.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": "Before you begin",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Select an objective: Awareness, Traffic, Engagement, Leads or Sales. Then click Continue.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": "Before you begin",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "At ad set level, in the Conversion section, select a conversion location or performance goal. Some objectives need extra settings.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": "Before you begin",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "At ad level, in Ad setup, select Single image or video or Carousel under Format.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": "Before you begin",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In the Destination section, search for an existing Instant Experience, or click + Create new and choose a template.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": "Before you begin",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Complete your Instant Experience and click Done.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": "Before you begin",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Complete the Ad creative section. Keep primary text to 125 characters, the headline to 40, and supply a landing page URL.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Text recommendations",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Check the Ad preview across placements, finish the remaining ad settings and click Publish.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": "Before you begin",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Click-through rate and product page visits: if the cover and product images match what shoppers want, more people may tap through. The trade-off is that a weak cover asset or a slow Instant Experience can waste those clicks.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Cost per purchase or lead: if the in-experience browsing shortens the path to a product page, conversion rate may rise and cost per result may fall. This depends on the product pages and the objective. The cost is extra build and maintenance effort, and nothing guarantees an uplift.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.collection_creative",
                "source_url": "https://www.facebook.com/business/help/1470043529695523",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a collection ad from Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },

    "feature_id": "meta.inventory-filter-for-feed-ads",
    "name": "Inventory filter for Feed ads",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.brand_safety.inventory_filter.inventory-filter-for-feed-ads"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Inventory filter is a brand suitability control that sets how sensitive the surrounding content can be for your Feed ads. It steers placement next to organic content; it does not guarantee your brand standards are met.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For Feed ads it covers Facebook and Instagram feed ads, Reels feed ads and ads in Threads feed. You choose from three filter settings, and Expanded is the default.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.reels_suitability",
                "source_url": "https://www.facebook.com/business/help/401717758239899",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About Feed and in-content brand safety and suitability controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "On Facebook, Instagram and Threads, the filter excludes certain videos and Feed content according to the setting you pick.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Content that breaks Meta's Community Standards, such as full nudity, excessive violence, terrorist acts or fact-checked misinformation, is excluded by default whatever setting you choose.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta states there is no guarantee that all content and publishers will align with your own brand suitability standards.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The feature is rolling out gradually, so you may not see it in your account yet. Feed ads filtering is available only in 34 listed languages, including English, Spanish, French, German, Hindi, Japanese and Arabic; check the full list in the source before relying on it.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": [
              "Gradual rollout",
              "Limited to 34 listed languages"
            ]
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when your brand needs tighter control over how sensitive the organic content next to your Feed, Reels feed or Threads feed ads can be, and your ads run in a supported language.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.reels_suitability",
                "source_url": "https://www.facebook.com/business/help/401717758239899",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About Feed and in-content brand safety and suitability controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you need guaranteed brand-safe delivery or exclusion of specific publishers, topics or content types. Meta says suitability controls offer no guarantee, and other tools such as block lists and topic exclusions exist separately.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.reels_suitability",
                "source_url": "https://www.facebook.com/business/help/401717758239899",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About Feed and in-content brand safety and suitability controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your audience is served in a language outside the supported list, or when the setting has not yet appeared in your account.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },

      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Brand suitability: a stricter setting may reduce the share of impressions next to content you consider unsuitable, if that content is excluded by the chosen level. The trade-off is that it removes inventory, and Meta gives no guarantee of alignment.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "CPM, reach and cost per result: a stricter setting shrinks the eligible placements, so where auction competition for the remaining inventory rises, CPM and cost per result could rise and reach could fall. Test it against the default before applying it to all spend.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.brand_safety.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/3001448133206080",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About inventory filter",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]

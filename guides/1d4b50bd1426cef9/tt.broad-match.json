      {
        "kind": "use_cases",
        "summary": "When to use broad match, and when to prefer tighter match types.",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you are launching a Search Ads campaign and want the highest volume of intent variants to learn from quickly.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.optimization",
                "source_url": "https://ads.tiktok.com/resources/help/article/search-ads-optimization?lang=en",

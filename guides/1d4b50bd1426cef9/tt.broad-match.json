      {
        "kind": "setup",
        "summary": "The vendor's recommended three-phase keyword workflow that includes broad match.",
        "status": "documented",
        "claims": [
          {
            "text": "Step 1: start your keyword set on Broad match to capture intent variants and learn quickly (the vendor's 'launch for scale' phase).",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.optimization",
                "source_url": "https://ads.tiktok.com/resources/help/article/search-ads-optimization?lang=en",
                "locator": "Keyword strategy",
                "source_site": "TikTok Ads Help Center",
                "source_title": "Search Ads optimisation",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Step 2: once terms are proven, promote them to Exact or Phrase match to lock in efficiency while maintaining reach (the 'optimize for precision' phase).",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.optimization",
                "source_url": "https://ads.tiktok.com/resources/help/article/search-ads-optimization?lang=en",

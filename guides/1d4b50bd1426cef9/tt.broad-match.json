                "source_site": "TikTok Ads Help Center",
                "source_title": "Search Ads optimisation",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Step 3: add negative keywords for irrelevant queries surfaced in the Search Terms report (the 'exclude noise' phase).",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.optimization",
                "source_url": "https://ads.tiktok.com/resources/help/article/search-ads-optimization?lang=en",
                "locator": "Keyword strategy",
                "source_site": "TikTok Ads Help Center",
                "source_title": "Search Ads optimisation",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Keep keyword–creative relevance high at each stage; the vendor notes relevancy is measured per keyword–creative pair.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.optimization",

            ],
            "conditions": [
              "during launch and learning phases"
            ]
          },
          {
            "text": "Do not rely on it when you need tight control on a proven, efficient term — the vendor recommends moving such terms to Phrase or Exact match after learning.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.optimization",
                "source_url": "https://ads.tiktok.com/resources/help/article/search-ads-optimization?lang=en",

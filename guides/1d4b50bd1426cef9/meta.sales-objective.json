{
  "schema_version": 1,
  "release": "1d4b50bd1426cef9",
  "guide": {
    "feature_id": "meta.sales-objective",
    "name": "Sales objective",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.ads.guide.image.sales-objective"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Sales is the campaign objective you pick when you want people to complete a purchase-type action. You set it at campaign level, and it only works well once you also choose where the outcome happens and which event counts.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Sales is one of six simplified objectives in Ads Manager, alongside Awareness, Traffic, Engagement, Leads and App promotion. It is supported for image ads.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Sales replaces the older Conversions objective for most purchase goals, and it also replaces Catalogue sales and some Messages campaigns.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "The objective sets the overall goal at campaign level. Your conversion location then says where the outcome happens, and your conversion event tells Meta which action you want people to take.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For Sales, the conversion locations are Website, App, Website and app, Website and in store, Website and calls, Messenger and WhatsApp.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Website events include purchase, add to cart, initiate checkout, add payment info, view content and others. Shops ads support only add to cart, add to wishlist, initiate checkout, purchase and view content.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For Website and app, you can only optimise for Meta pixel events tracked by both Aggregated Event Measurement and your app SDK.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The objective also determines which placements and calls to action are available.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you want purchases or other transactional actions, such as add to cart or checkout, on your website, in your app, or in Messenger or WhatsApp.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Use it when you are recreating an old Conversions or Catalogue sales campaign. For catalogue sales, choose your catalogue during setup. Meta recommends Advantage+ catalogue ads.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your goal is leads or sign-ups. Meta maps Lead generation and some Conversions campaigns to the Leads objective, and Messages to Messenger leads also maps to Leads.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you run Shops ads and want events beyond the five supported ones. Events such as complete registration or subscribe are not available there.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Meta documents the choices to make, not the exact menu path or labels. This setup stops there.",
        "status": "documented",
        "claims": [
          {
            "text": "In Ads Manager, create a campaign and choose Sales as the campaign objective at campaign level.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choose the conversion location where you want the sale to happen: website, app, website and app, website and in store, website and calls, Messenger or WhatsApp.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choose the conversion event, such as purchase, that matches the action you want. Not every location needs an event.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For a catalogue campaign, choose your catalogue during campaign setup.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Track purchases if you choose Purchase as the website conversion event. An earlier event such as Add to cart tracks a different action and does not count completed purchases.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",

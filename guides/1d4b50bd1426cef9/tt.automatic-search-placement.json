      "tiktok.search.automatic_placement.automatic-search-placement"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Automatic Search Placement (formerly called Search Ads Toggle) is a campaign-setup setting that lets your ads be considered for placement against TikTok search queries.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.automatic_placement",
                "source_url": "https://ads.tiktok.com/help/article/faqs-for-automatic-search-placement?lang=en",
                "locator": null,
                "source_site": "TikTok Ads Help Center",
                "source_title": "Automatic Search Placement",
                "raw_sha256": null,
                "cleaned_sha256": "9f2c1a44e01b0a3f8f70e5db24a6221ac7dfc0e0f0f4d8c8b1e39c65d9f0a512"
              }
            ],
            "conditions": []
          },
          {
            "text": "Keywords are automatically created, matched, and connected with ads to respond to user queries — you never provide a keyword list for this feature.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.automatic_placement",
                "source_url": "https://ads.tiktok.com/help/article/faqs-for-automatic-search-placement?lang=en",
                "locator": null,
                "source_site": "TikTok Ads Help Center",
                "source_title": "Automatic Search Placement",
                "raw_sha256": null,
                "cleaned_sha256": "9f2c1a44e01b0a3f8f70e5db24a6221ac7dfc0e0f0f4d8c8b1e39c65d9f0a512"
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "The automatic system learns relevant keywords from the App name, custom identity, video content (including text and non-text elements), URL (content from the web landing page), and video title.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.automatic_placement",
                "source_url": "https://ads.tiktok.com/help/article/faqs-for-automatic-search-placement?lang=en",
                "locator": null,
                "source_site": "TikTok Ads Help Center",
                "source_title": "Automatic Search Placement",
                "raw_sha256": null,
                "cleaned_sha256": "9f2c1a44e01b0a3f8f70e5db24a6221ac7dfc0e0f0f4d8c8b1e39c65d9f0a512"
              }
            ],
            "conditions": []
          },
          {
            "text": "Turning the setting on only makes your ad eligible for search placement; it does not guarantee delivery. The delivery system also weighs ad relevancy to the query, metadata, budgets, and competition when deciding which ad to serve.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.automatic_placement",
                "source_url": "https://ads.tiktok.com/help/article/faqs-for-automatic-search-placement?lang=en",
                "locator": null,
                "source_site": "TikTok Ads Help Center",
                "source_title": "Automatic Search Placement",
                "raw_sha256": null,
                "cleaned_sha256": "8a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778889900aabbccddee"
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you want to capture incremental search-driven demand for terms related to your product without maintaining a keyword list, and you are comfortable with the system deriving relevance from your creative and landing-page signals.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "tiktok.search.automatic_placement",
                "source_url": "https://ads.tiktok.com/help/article/faqs-for-automatic-search-placement?lang=en",
                "locator": null,
                "source_site": "TikTok Ads Help Center",
                "source_title": "Automatic Search Placement",
                "raw_sha256": null,
                "cleaned_sha256": "9f2c1a44e01b0a3f8f70e5db24a6221ac7dfc0e0f0f4d8c8b1e39c65d9f0a512"
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you need guaranteed search delivery or keyword-level control — delivery under search placement is not guaranteed, and no keyword-specific control is available at this time.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.automatic_placement",
                "source_url": "https://ads.tiktok.com/help/article/faqs-for-automatic-search-placement?lang=en",
                "locator": null,
                "source_site": "TikTok Ads Help Center",
                "source_title": "Automatic Search Placement",
                "raw_sha256": null,
                "cleaned_sha256": "8a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778889900aabbccddee"
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Automatic Search Placement is enabled as part of campaign setup.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.automatic_placement",

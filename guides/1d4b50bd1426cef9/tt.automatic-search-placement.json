      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Search placement impressions and search-attributed traffic are a useful reporting-focused KPI here: because eligibility is granted but delivery is decided by relevancy, budget, and competition, monitoring search delivery reflects whether your ads are actually winning search auctions, not just eligible for them. Trade-off: low search delivery may reflect genuine competition or relevancy gaps rather than a misconfiguration, so impressions alone should not be read as a performance failure or as incremental uplift.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "tiktok.search.automatic_placement",
                "source_url": "https://ads.tiktok.com/help/article/faqs-for-automatic-search-placement?lang=en",
                "locator": null,
                "source_site": "TikTok Ads Help Center",
                "source_title": "Automatic Search Placement",
                "raw_sha256": null,
                "cleaned_sha256": "8a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778889900aabbccddee"
              }
            ],
            "conditions": []
          }

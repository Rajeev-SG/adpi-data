    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Instagram Reels is a placement you can include in a Meta campaign so your ads run in the Reels tab on Instagram. It is a delivery surface, not a bidding or audience setting, and with Advantage+ placements on, Reels is included for you.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Create Instagram Reels ads in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta lists Instagram Reels as a selectable placement for image ads in its ads guide.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Choose your ad placement: 'Instagram Reels'",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Approved ads can appear in the Reels tab or in the feed view of the Reels tab on public Instagram profiles of people aged 18 and older.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Create Instagram Reels ads in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "It works as a placement choice in the Placements section of campaign setup. With Advantage+ placements on, Meta includes Reels ads automatically. If you pick placements manually, you must tick Reels yourself.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Create Instagram Reels ads in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Format support differs by type. Image, video and collection are supported on Instagram Reels, while carousel supports image carousels only.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.placement_objectives",
                "source_url": "https://www.facebook.com/business/help/279271845888065",
                "locator": "Stories, status and reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available ad placements for marketing objectives",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Objectives available for Reels ads include awareness, traffic, engagement, leads, app promotion and sales.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Create Instagram Reels ads in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you want your ads in Instagram's Reels tab and your campaign has an awareness, traffic, engagement, leads, app promotion or sales objective, with creative in a supported format.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Create Instagram Reels ads in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you need guaranteed Reels delivery in every market. Meta publishes a separate country availability page, and Meta does not state availability.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Learn more",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on Advantage+ placements to control Reels spend. It includes Reels automatically, so switch to manual placement selection if you need to include or exclude Reels deliberately.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Create Instagram Reels ads in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "The documented path covers campaign setup up to placement selection and publishing. Creative specifications are not covered here.",
        "status": "documented",
        "claims": [
          {
            "text": "Open Meta Ads Manager and click + Create campaign.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choose an objective: Awareness, Traffic, Engagement, Leads, App promotion or Sales.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Edit your budget, schedule, audience and placements.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In the Placements section, leave Advantage+ placements on to have Reels included automatically.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "To choose placements yourself, click Show more settings and select Reels among your placements.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Click Next, add your ad's identity, destination and creative, preview it, then click Publish.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Reach and impressions: adding Reels can widen the inventory your ads can win, which may raise reach if your budget and audience are not already saturated. The trade-off is that spend can shift towards a surface with different creative expectations.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Create Instagram Reels ads in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Cost per result: if Reels delivers results more cheaply than your other placements, including it may lower blended cost per result. If it does not, automatic inclusion may raise it. Check results by placement in your reporting before judging. This is attributed performance, not proven incrementality.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.reels.instagram_ads",
                "source_url": "https://www.facebook.com/business/help/4023434621109377",
                "locator": "Create Instagram Reels ads in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram Reels ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "relationships",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Other platforms offer placement choices, but none of the candidates is a like-for-like Reels surface, so treat them as related rather than interchangeable.",
            "status": "inferred",
            "evidence": [],
            "conditions": []
          }
        ]

            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.value_lookalike",
                "source_url": "https://www.facebook.com/business/help/458132024732845",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a value-based Lookalike Audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Cost per acquisition may fall if a tighter audience size, built from a high-quality source, reaches people closer to your best customers. The trade-off is smaller reach and potentially higher CPMs or slower delivery. Your results are attributed outcomes, not proven incremental gains.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.lookalike_audiences",
                "source_url": "https://www.facebook.com/business/help/164749007013531",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About Lookalike Audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Reach and prospecting volume may rise with larger percentages, at the cost of weaker similarity to the source and possibly lower conversion rate.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.lookalike_audiences",
                "source_url": "https://www.facebook.com/business/help/164749007013531",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About Lookalike Audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },

        "claims": [
          {
            "text": "TikTok documents that Advanced Matching data is used to optimize targeting and measurement for ad campaigns — it is a control-and-signal input, not a reporting-only setting.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.advanced_matching",

        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Cost per acquisition: excluding existing customers from prospecting may cut spend on people who would not be new buyers, if your list is large and well matched. The trade-off is a smaller eligible audience, which can raise CPMs or limit scale.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.custom_audiences",
                "source_url": "https://www.facebook.com/business/help/744354708981227",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About custom audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Return on ad spend on repeat purchase: targeting known customers may lift it if your offers suit them. The trade-off is frequency fatigue, and results depend on match rate and list quality, which are not documented here.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.customer_list",
                "source_url": "https://www.facebook.com/business/help/170456843145568",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a customer list custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "New-customer conversion rate: a lookalike built from your best customers may improve prospecting efficiency. It depends on source quality and is not guaranteed. Reported conversions are attributed, not proof of incremental sales.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.custom_audiences",
                "source_url": "https://www.facebook.com/business/help/744354708981227",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About custom audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]

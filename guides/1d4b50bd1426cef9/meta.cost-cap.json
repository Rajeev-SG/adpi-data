  "guide": {
    "feature_id": "meta.cost-cap",
    "name": "Cost cap bidding",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.ads.campaign_bid_strategy.cost-cap-bidding"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Cost cap is a Meta bid strategy that tries to get the most results from your budget while keeping the average cost per optimisation event at or near an amount you set. It is a limit on average cost, not a guarantee of a fixed cost on every result.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "Field bid_strategy",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal works",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It is a bidding control: you supply the cost ceiling and Meta decides bids auction by auction. Your actual weekly average cost per result may vary from the amount you set.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal works",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "The cost cap value is stored in the bid amount field of each ad set in the campaign, so each ad set carries its own cap.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "applicable condition (prerequisite)",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The campaign-level strategy applies when campaign budget optimisation is on and the buying type is Auction. Without campaign budget optimisation, the bid strategy is read at ad set level.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "Field bid_strategy",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta's AI raises or lowers the bid per auction to maximise conversions while aiming to keep the weekly average cost near your goal. Day-to-day cost will fluctuate, so judge it on weekly averages.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal works",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Each bid strategy may only be available for certain optimisation goals, so check that your ad set's goal supports it.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "applicable condition (eligibility)",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Campaigns with more than 70 ad sets using campaign budget optimisation cannot edit the bid strategy or turn off campaign budget optimisation.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "applicable condition (eligibility)",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you have a firm CPA target and want to scale conversions with a cost guardrail, and when each ad set can reach roughly 50-100 conversions a week.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal works",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when spending your full budget matters more than cost. In a competitive market it may underspend to protect the cost target; Highest volume prioritises full spend instead.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal and Highest volume bid strategies differ",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when conversion volume is low. Below the 50-100 weekly conversions threshold, Meta suggests broadening the audience, raising the budget or raising your cost goal.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal works",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Meta documents the required settings by their API field names, not the Ads Manager menu path, so the exact interface labels are not covered here.",
        "status": "documented",
        "claims": [
          {
            "text": "Create the campaign with the Auction buying type.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "Field bid_strategy",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Turn on campaign budget optimisation so the bid strategy is set at campaign level.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "Field bid_strategy",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Set the campaign bid strategy to COST_CAP (cost cap).",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "Field bid_strategy",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choose an optimisation goal for each ad set that supports cost cap.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "applicable condition (eligibility)",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Enter your cost cap in the bid amount field of every ad set in the campaign.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "applicable condition (prerequisite)",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Wait at least 7 days after any change before re-evaluating, and judge results on weekly averages.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal works",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Cost per result (CPA): if your cap is realistic for the auction, the cap can hold weekly average CPA closer to target than uncapped lowest cost. Trade-off: a tight cap can reduce delivery and conversion volume.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.ads.campaign_bid_strategy",
                "source_url": "https://developers.facebook.com/docs/graph-api/reference/adcampaigngroup/",
                "locator": "Field bid_strategy",
                "source_site": "Meta for Developers",
                "source_title": "Ad Campaign bid strategies",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal and Highest volume bid strategies differ",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Budget delivery (spend and conversion volume): because the strategy may spend less than your full budget to protect the target, spend can fall short when the market is competitive. Raising the cap may recover volume at a higher cost.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal and Highest volume bid strategies differ",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Cost stability: with enough weekly conversions the system has more data to control cost, so weekly averages may be steadier. With few conversions, expect more variance from your goal. These are attributed results, not proven incremental outcomes.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.cost_per_result_goal",
                "source_url": "https://www.facebook.com/business/help/272336376749096",
                "locator": "How Cost per result goal works",
                "source_site": "Meta Business Help Centre",
                "source_title": "About cost per result goal bid strategy",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]

                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The setting lives at the ad group level, alongside brand safety options in the Placements and brand safety section.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.smart_plus.updates",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-updates-to-smart-plus?lang=en",

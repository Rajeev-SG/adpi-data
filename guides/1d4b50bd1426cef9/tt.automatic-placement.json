                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you need to guarantee your ads appear on specific placements; in that case switch to Select placement and choose the placements you want.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "tiktok.smart_plus.updates",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-updates-to-smart-plus?lang=en",
                "locator": "If you prefer more manual control, choose the Select placement option and choose the specific placements you'd like to include",

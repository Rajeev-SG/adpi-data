                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choosing Select placement lets you manually include specific placements instead.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.smart_plus.updates",

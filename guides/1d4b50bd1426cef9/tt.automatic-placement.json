      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Because Automatic placement lets the system decide where ads serve, delivery and conversion volume by placement is the natural thing to monitor; if Smart+ creative-level reporting is available, use it to see which creative combinations perform, and compare against a Select placement period if you want to judge whether automatic delivery helps or hurts. The trade-off: automatic delivery may reach placements you would not have chosen manually, which can raise volume while diluting placement-level control.",
            "status": "inferred",
            "evidence": [

      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you want a hands-off Smart+ setup and are comfortable letting TikTok decide where your ads serve across its placements.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "tiktok.smart_plus.updates",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-updates-to-smart-plus?lang=en",
                "locator": "Automatic placement is set by default",

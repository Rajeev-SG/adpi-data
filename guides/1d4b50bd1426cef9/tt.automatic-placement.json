                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It applies only within the upgraded Smart+ experience, which is available for the Traffic, Sales, Lead Generation, and App Promotion objectives.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.smart_plus.updates",

                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It is the default setting for Smart+ ad groups; advertisers who want control can switch to Select placement instead.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.smart_plus.updates",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-updates-to-smart-plus?lang=en",
                "locator": "Automatic placement is set by default",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About upgrades to Smart+",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Under Automatic placement, placements are selected automatically by the system rather than chosen by the advertiser.",

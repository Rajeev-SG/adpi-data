      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "A useful indicator is the quality of leads reaching your site: since Shopping ads give users a clear view of the product (photo, title, price, store name) before they click, Google attributes the format with producing more qualified leads. A practical metric to watch is click-to-purchase conversion rate on Shopping traffic, because the causal path runs: richer pre-click product information -> better-matched, better-informed clicks -> a higher share of clicks that convert. The trade-off is that this is an attributed reporting outcome, not an incremental uplift measurement, and it assumes your product data is accurate and current.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "About Shopping ads",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": [
              "Because Shopping ads show price and product details before the click, the search match may pre-qualify clicks; this is a documented qualitative claim, not a measured uplift figure."
            ]
          }
        ]
      },

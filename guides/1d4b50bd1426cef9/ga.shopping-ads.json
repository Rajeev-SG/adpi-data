    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Shopping ads show a product photo, title, price, store name and more, giving users a clear view of the product before they click.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "About Shopping ads",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "They are managed in Google Ads through Shopping campaigns or Performance Max campaigns.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "About Shopping ads",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Google states the format can promote online and local inventory, boost traffic to a website or local store, and find better qualified leads.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "About Shopping ads",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Shopping ads use Merchant Center product data, not keywords, to decide how and where ads show; submitted product details are matched to a user's search to show the most relevant products.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "How Shopping ads work",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Google may use landing page, image, feed and other signals, including content created by Google AI, to enrich the ads; you can opt out via your account manager or contact form, with requests typically processed in 3-5 business days.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "How Shopping ads work",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Performance Max is a goal-based campaign type that looks at inputs such as budget and product feed and optimises performance based on them.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "How Shopping ads work",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Ads may also serve on Google Search Partner websites, but only if the campaign is set to include search partners.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "Google Search Partner websites (if your campaign is set to include search partners)",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you are a retailer wanting to promote online and local inventory and drive traffic to your website or local store.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "About Shopping ads",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you need keyword-targeted text ads: Shopping ads match on product data rather than keywords, so keyword-level targeting control is not how the format works.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "About Shopping ads",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Local Inventory Ads turn on automatically once a local products inventory feed is attached to the campaign, so attach that feed when you want local store inventory surfaced.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "Opted in automatically when a local products inventory feed is attached to the campaign",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Link your Google Ads account to Merchant Center.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "Learn how to Link a Google Ads account to Merchant Center",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Manage your Shopping ads in Google Ads using a Shopping or Performance Max campaign.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "How Shopping ads work",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In CSS program countries, participate through one or several Comparison Shopping Services of your choice.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "Note: In Comparison Shopping Service (CSS) program countries, you participate in Shopping ads through one or several CSSs of your choice.",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For Performance Max Vehicle ads, ensure the Merchant Center account is opted into the Vehicle ads program and a supported objective (Leads or Sales) is selected; for Shopping campaign Vehicle ads, select a Vehicle Feed and ensure approved vehicle offers exist in Merchant Center.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "If your Merchant Center account is opted in for the Vehicle ads program and one of the supported objectives (Leads, Sales) have been selected, you will be automatically opted in.",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Google Ads does not document a complete step-by-step wizard path for creating the campaign itself, so this guide stops at the documented setup requirements.",
            "status": "not_documented",
            "evidence": [
              {
                "source_id": "google.shopping.standard",
                "source_url": "https://support.google.com/google-ads/answer/2454022?hl=en",
                "locator": "About Shopping ads",
                "source_site": "Google Ads Help",
                "source_title": "About Shopping ads",

    "sections": [
      {
        "kind": "definition",
        "summary": "Collage ads let advertisers combine multiple product cutouts into one interactive image on Pinterest.",
        "status": "documented",
        "claims": [
          {
            "text": "Collage ads are an interactive ad format on Pinterest designed to help advertisers visualise products by combining multiple product cutouts into a single image.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.formats.collage",
                "source_url": "https://help.pinterest.com/en-gb/business/article/collage-ads",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Collage ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "When people tap on a cutout, they see more details and a link to the advertiser's website.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.formats.collage",
                "source_url": "https://help.pinterest.com/en-gb/business/article/collage-ads",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Collage ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "Interaction is driven by tappable cutouts, each of which reveals product details and a destination link.",
        "status": "documented",
        "claims": [
          {
            "text": "Each cutout in the collage is interactive: tapping it shows more details and a link to the advertiser's website.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.formats.collage",
                "source_url": "https://help.pinterest.com/en-gb/business/article/collage-ads",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Collage ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In Ads Manager, a collage ad can be set as a multi-destination collage, where each cutout links to its specific product page, or a single-destination collage, where all cutouts link to one destination URL.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.formats.collage",
                "source_url": "https://help.pinterest.com/en-gb/business/article/collage-ads",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Collage ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Because cutouts are tappable and can each carry their own destination, tapping and outbound clicks per cutout are the attributable interaction signals; downstream outcomes such as deeper sales-funnel engagement are conditional results the format is designed to encourage, not guaranteed uplift.",
            "status": "inferred",
            "evidence": [],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "Best suited to visualising a range of related products, with landing-page strategy matched to whether you want browsing or a hero-product focus.",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you want people to visualise and explore a range of products from one cohesive theme or category, with each tap revealing details and a relevant link.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.formats.collage",
                "source_url": "https://help.pinterest.com/en-gb/business/article/collage-ads",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Collage ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your imagery cannot be cut out cleanly: the format assumes Pins with white or plain backgrounds and imagery you own or are licensed to use, so busy or unlicensed visuals are a poor fit.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.formats.collage",
                "source_url": "https://help.pinterest.com/en-gb/business/article/collage-ads",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Collage ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Use multi-item landing pages when you want people to browse a product range and drive deeper sales-funnel engagement; use single-item landing pages when you want to focus attention on one hero product.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.formats.collage",
                "source_url": "https://help.pinterest.com/en-gb/business/article/collage-ads",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Collage ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },

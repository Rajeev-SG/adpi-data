                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "A useful metric to watch is the volume of searches your keyword list covers: because ads serve only when a search matches your keywords, an under-sized list can limit impressions; Pinterest's 25-keyword minimum recommendation reflects this, though the trade-off is that broader matching trades precision for reach.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": [
              "if delivery reporting shows a very small share of eligible searches triggering the ad"
            ]
          },
          {
            "text": "Pinterest reports no performance uplift, conversion or cost benchmarks for keyword targeting, so no outcome figures can be stated.",
            "status": "not_documented",
            "evidence": [],

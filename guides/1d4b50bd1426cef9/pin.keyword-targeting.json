        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Pinterest recommends using at least 25 keywords per ad group for best results.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",

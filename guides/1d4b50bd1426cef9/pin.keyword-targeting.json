  "guide": {
    "feature_id": "pin.keyword-targeting",
    "name": "Keyword targeting",
    "vendor": "Pinterest",
    "platform": "Search",
    "capability_ids": [
      "pinterest.search.keywords.keyword-targeting"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Keyword targeting reaches people as they search for a specific idea on Pinterest, using keywords related to the promoted ad.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": "Keyword targeting lets you reach people as they search for a specific idea on Pinterest.",
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For example, a living room furniture ad can target searches like 'living room décor' or 'home décor ideas'.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Keywords are configured per ad group, in Ads Manager or Bulk Editor.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "The ad is triggered when a person's search matches a selected keyword; match types control how loosely or tightly that matching happens.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Phrase match requires the entire phrase to be included in the search; exact match limits serving to the keyword itself.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Negative keywords exclude certain search terms from triggering ads and can be set at the ad group level.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Because delivery depends on search queries matching your keyword list, a very small list narrows reach; broad match widens it but risks less relevant matches — this is a reach-vs-precision trade-off, not a guaranteed performance difference.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": [
              "conditional on search matching the selected keywords",
              "after campaign review is complete"
            ]
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you want to reach people with clear commercial or inspiration intent, such as shoppers searching for a specific product idea like living room décor.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Use it when you need precise control over which searches trigger your ad, for example by narrowing to phrase or exact matches.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Use it when some searches should never trigger your ad — negative keywords let you exclude specific terms.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your goal is audience characteristics rather than search intent — the mechanism is triggered by what people search, not by who they are.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "You need a Pinterest business account in a region where Pinterest Ads are available; Ads are not yet available in all regions.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Step 1: Log in to your Pinterest business account, click the hamburger icon at the top left, and under Manage campaigns click Create campaign.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Step 2: Click Manual campaign, then Get started, and choose New ad group from the left-side navigation, then select a targeting strategy.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Step 3: Under Interests and keywords, tick Enable keywords, then click Add keywords and either type a comma-separated list or search and add keywords.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Step 4: Optionally specify match types by formatting each keyword (quotation marks for phrase, brackets for exact, minus signs for negative matches).",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Step 5: Set Budget and schedule, Optimisation and delivery, and Ads; review your information and click Publish.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Bulk Editor route: download a sample sheet, enter each keyword on its own row in the Keyword column, optionally set match types in the Match Type column, then upload the template.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "To edit later, open the ad in Ad account overview, go to the Keywords tab, and use Create keywords, Create negative keywords, or Archive to remove unwanted keywords.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Limit on volume: up to 20,000 keywords per ad group; Ads Manager allows adding or removing up to 5,000 or updating up to 2,500 at a time, while Bulk Editor handles up to 20,000 in one operation.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "After launch, campaigns are reviewed against Advertising guidelines, which can take up to 24 hours before ads are distributed.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.search.keywords",
                "source_url": "https://help.pinterest.com/en-gb/business/article/keyword-targeting",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Keyword targeting",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {

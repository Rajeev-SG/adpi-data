    "feature_id": "meta.reels-brand-safety-tools",
    "name": "Reels brand safety tools",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.reels.instagram.reels-brand-safety-tools"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Meta lets you apply brand safety tools, including block lists and publisher lists, to ads running on Instagram Reels. They are exclusion and suitability controls, not a guarantee that every reel next to your ad is on-brand.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram",
                "source_url": "https://www.facebook.com/business/help/128078290241927",
                "locator": "Publish ads on Instagram Reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "About ads on Instagram Reels",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta defines brand suitability controls as tools that help you place ads next to organic content that suits your brand, where organic means content not promoted as an ad.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/252190302162738",
                "locator": "Learn more",
                "source_site": "Meta Business Help Centre",
                "source_title": "Use inventory filter in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Block lists and publisher lists are the tools named for Instagram Reels. Meta's help centre groups them with publisher and content block lists and partner-publisher lists.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram",
                "source_url": "https://www.facebook.com/business/help/128078290241927",
                "locator": "Publish ads on Instagram Reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "About ads on Instagram Reels",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta's Feed-ads suitability controls cover Reels feed ads. They give you more say over which organic content your ads can sit beside.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.reels_suitability",
                "source_url": "https://www.facebook.com/business/help/401717758239899",
                "locator": "Brand suitability controls for Feed ads",
                "source_site": "Meta Business Help Centre",
                "source_title": "About Feed and in-content brand safety and suitability controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Ads can appear on reels from creators who do not earn money from ads. Creators must meet Meta's monetisation eligibility requirements and complete onboarding to earn.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.reels.instagram",
                "source_url": "https://www.facebook.com/business/help/128078290241927",
                "locator": "Publish ads on Instagram Reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "About ads on Instagram Reels",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta does not say which inventory filter tiers or exclusions apply to Instagram Reels specifically, so check the live help page before promising a client a particular setting.",
            "status": "not_documented",
            "evidence": [],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Use it when your brand has publishers or content you must keep away from, and you want to apply block lists or publisher lists to Instagram Reels placements.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.reels.instagram",
                "source_url": "https://www.facebook.com/business/help/128078290241927",
                "locator": "Publish ads on Instagram Reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "About ads on Instagram Reels",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you need proof of exactly what each ad appeared beside. Ads can still appear on reels from non-monetising creators, and Meta does not document Reels-specific guarantees.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.reels.instagram",
                "source_url": "https://www.facebook.com/business/help/128078290241927",
                "locator": "Publish ads on Instagram Reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "About ads on Instagram Reels",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Meta documents only the entry point for inventory filter settings. It does not give the menu labels for block lists on Instagram Reels, so the path stops here.",
        "status": "inferred",
        "claims": [
          {
            "text": "Open Ads Manager and create a new ad set, or edit an existing one.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/252190302162738",
                "locator": "(none)",
                "source_site": "Meta Business Help Centre",
                "source_title": "Use inventory filter in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In the ad set, select the inventory filter settings for Feed ads. Meta says these features are rolling out gradually, so you may not see them yet.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/252190302162738",
                "locator": "(none)",
                "source_site": "Meta Business Help Centre",
                "source_title": "Use inventory filter in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For block lists and publisher lists, use Meta's help articles on applying a publisher block list in Ads Manager. The documented material does not include those steps.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.inventory_filter",
                "source_url": "https://www.facebook.com/business/help/252190302162738",
                "locator": "Learn more",
                "source_site": "Meta Business Help Centre",
                "source_title": "Use inventory filter in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Brand suitability or unsafe-adjacency incident rate: if the lists exclude the publishers and content you object to, fewer ads may appear beside them. The trade-off is that restricting inventory can shrink reach.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.reels.instagram",
                "source_url": "https://www.facebook.com/business/help/128078290241927",
                "locator": "Publish ads on Instagram Reels",
                "source_site": "Meta Business Help Centre",
                "source_title": "About ads on Instagram Reels",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "CPM and cost per result: narrower eligible inventory can raise auction costs if the excluded reels would have delivered cheaply. Compare results before and after you add restrictions. This is not a guaranteed effect either way.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.reels_suitability",
                "source_url": "https://www.facebook.com/business/help/401717758239899",
                "locator": "Brand suitability controls for Feed ads",
                "source_site": "Meta Business Help Centre",
                "source_title": "About Feed and in-content brand safety and suitability controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]

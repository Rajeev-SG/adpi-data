  "guide": {
    "feature_id": "meta.engagement-custom-audiences",
    "name": "Engagement Custom Audiences",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.custom_audiences.video-engagement-custom-audience",
      "meta.custom_audiences.lead-form-engagement-custom-audience",
      "meta.custom_audiences.facebook-page-engagement-custom-audience"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Engagement custom audiences let you retarget people who interacted with your content on Meta platforms. They are built from your videos, lead forms or Facebook Page, and they are a targeting source rather than a bidding goal or a guarantee of results.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.custom_audiences",
                "source_url": "https://www.facebook.com/business/help/744354708981227",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About custom audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Each source is its own audience type: video engagement, lead form engagement and Facebook Page engagement.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.custom_audiences",
                "source_url": "https://www.facebook.com/business/help/744354708981227",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About custom audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "For video audiences, you choose an engagement level (all viewers, engaged viewers or highly engaged viewers), up to 200 videos, and a retention period in days.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": "Create a video engagement custom audience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "People leave the audience when the retention period passes unless they engage again. New engagers are added automatically, so the audience refreshes without you editing it.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": "Create a video engagement custom audience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "If a video was reused from a post, the audience is built only from the views recorded for that post. This can be far fewer than the campaign's total views.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": "Before you create a video engagement custom audience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "An ad account can hold up to 500 custom audiences, and you can build a lookalike audience from one.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.custom_audiences",
                "source_url": "https://www.facebook.com/business/help/744354708981227",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About custom audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "You can't create new ad sets with audiences based on a deleted Facebook Page. This also applies to its associated lookalike audiences, special ad audiences and saved audiences.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you have recent video, lead form or Page interactions and want to re-engage those people, or seed a lookalike audience from them.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.custom_audiences",
                "source_url": "https://www.facebook.com/business/help/744354708981227",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "About custom audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your video views mostly came from reused posts, or when your Page has been deleted. The audience may be much smaller than your reported views, or unusable in new ad sets.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it for exclusions of customers you hold in a file. Meta documents a separate exclusion-only audience type for that.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.custom_audiences",
                "source_url": "https://www.facebook.com/business/help/744354708981227",
                "locator": "Custom audiences of people who interacted with your business",
                "source_site": "Meta Business Help Centre",
                "source_title": "About custom audiences",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Only the video engagement path is documented step by step. Meta gives no click path for lead form or Facebook Page engagement audiences, so this guide stops there.",
        "status": "documented",
        "claims": [
          {
            "text": "Open Audiences in Ads Manager on desktop.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Click Create audience, then Custom audience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Click Video, then Next.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Under Include, choose All video viewers, Engaged video viewers or Highly engaged video viewers.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Click Select video and choose up to 200 videos. Use the Video sources menu to pick Facebook Page, Instagram professional account, Campaign or Video ID, then click Confirm.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In Keep people in this audience for, enter the number of days people stay after engaging.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Optionally add a name and description, then click Create audience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "When Status shows Ready in Audiences, select the audience in the ad set targeting.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.engagement_audience",
                "source_url": "https://www.facebook.com/business/help/1099865760056389",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create a video engagement custom audience",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",

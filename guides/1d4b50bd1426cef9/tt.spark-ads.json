    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Spark Ads is an ad format supported within TikTok's Search Ads Campaign, delivered on the TikTok Search Results Page.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "The Search Ads Campaign supports Spark Ads",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The Search Ads Campaign is a TikTok ad campaign that uses keywords to reach people searching for terms related to your product or service, with ads targeted uniquely and exclusively to the TikTok Search Results Page.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "keywords to help you reach people searching",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "When clicked or tapped, the search ad adopts the regular in-feed video format, appearing within Search stream ads inventory.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "Ad Open",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "As users scroll the search results page, search ads can autoplay when visible on screen; an autoplayed video counts as both a view and an impression, while a still image ad counts only an impression.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "Autoplay",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Autoplayed ads also contribute to video-view metrics (100%, 75%, 50%, 25%), serving as both an impression and a video view.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "Autoplay",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Exact ad position (first, second, third, etc.) may vary based on relevancy and feature experimentation.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "Ad Position",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Multiple creatives are supported within one ad group (multiple videos or a Carousel Image Ad), but only one video can be displayed (default selected).",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "Ad Format; Creative",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The video format mirrors in-feed video campaigns, so creative from in-feed campaigns can be repurposed for search campaigns; creative selection logic follows the same principles as feed-side logic.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "Creative",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The interactive add-on for Search Ads Campaign currently supports only display cards and does not support stickers or other interactive add-ons.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "tiktok.search.overview",
                "source_url": "https://ads.tiktok.com/resources/help/article/about-search-ads-campaign?lang=en",
                "locator": "Ad Preview for Search Campaign",
                "source_site": "TikTok Ads Help Center",
                "source_title": "About Search Ads Campaign",
                "raw_sha256": null,

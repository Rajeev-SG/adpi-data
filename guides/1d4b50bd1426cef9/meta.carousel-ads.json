    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Carousel ads put two or more images or videos in one ad, and people swipe or click through them. Each card has its own headline, description, link and call to action, so the key thing to get right is writing every card as its own landing point.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.carousel_creative",
                "source_url": "https://www.facebook.com/business/help/927639917355563",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Best practices for carousel ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "On Facebook Feed, a carousel can hold 2 to 10 cards.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.carousel",
                "source_url": "https://www.facebook.com/business/ads-guide/update/carousel",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Carousel ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "This is a creative format, not a targeting or bidding control. It changes what people see and click, while audience, placement, budget and schedule are set at ad set level and shared by all ads in that ad set.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "You design the carousel at ad level, the bottom of the campaign, ad set and ad structure.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Viewers move through cards by swiping on mobile or clicking arrows on desktop.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.carousel_creative",
                "source_url": "https://www.facebook.com/business/help/927639917355563",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Best practices for carousel ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta also documents an option to show best-performing cards first. Meta gives only the article title, so check how it behaves before relying on it.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.carousel_creative",
                "source_url": "https://www.facebook.com/business/help/927639917355563",
                "locator": "Learn more",
                "source_site": "Meta Business Help Centre",
                "source_title": "Best practices for carousel ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Use it when you want to show several products, features or steps in one ad and send each card to a different link with its own call to action.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.carousel_creative",
                "source_url": "https://www.facebook.com/business/help/927639917355563",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Best practices for carousel ads",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Specs for Facebook Feed: images JPG or PNG up to 30 MB; videos MP4, MOV or GIF up to 4 GB and 1 second to 240 minutes; 3% aspect ratio tolerance. Other placements may differ, so check Meta's supported objectives and placements article.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.carousel",
                "source_url": "https://www.facebook.com/business/ads-guide/update/carousel",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Carousel ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on the carousel format if you only have one card. The Facebook Feed carousel specifications require at least two.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.carousel",
                "source_url": "https://www.facebook.com/business/ads-guide/update/carousel",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Carousel ad specifications",
                "raw_sha256": "42c564f15abef6df38eb96fa3c32db9665001ca13d92e5633000c2c8949b7ebc",
                "cleaned_sha256": "d605595de1eb383469d9a29579b080585f0eec9f8d9f7a97687ae0617d70d004"
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Meta names the Ads Manager and Page creation routes but not their menu steps, so this path stops here.",
        "status": "documented",

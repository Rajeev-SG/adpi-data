                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Prepare 2 to 10 cards at 1:1, at least 1080 x 1080 pixels, in the file types above.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.carousel",
                "source_url": "https://www.facebook.com/business/ads-guide/update/carousel",

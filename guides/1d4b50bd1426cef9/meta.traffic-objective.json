  "guide": {
    "feature_id": "meta.traffic-objective",
    "name": "Traffic objective",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.ads.guide.image.traffic-objective"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Traffic is one of Meta's six Ads Manager campaign objectives. You choose it at campaign level to send people to a destination such as a website, app or messaging thread. It needs no conversion event, so it doesn't tell Meta to chase purchases or leads.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Choose an objective",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": "Traffic",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Traffic is a supported objective for image ads. The objective you pick determines which placements and calls to action are available.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Supported objectives: 'Traffic'",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The old Traffic objective maps directly to the simplified Traffic objective, with no additional settings required.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "Recreate a campaign that used an original ad objective in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "The objective is set at campaign level, the top of the structure. Ad sets and ads beneath it share that overall goal, so you can test audiences, budgets and creatives inside one Traffic campaign.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": "The three advertising levels in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": "How the advertising levels work together in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "With Traffic you choose a conversion location, which is where the outcome happens: Website, App, Messenger, WhatsApp, Calls or Instagram profile. No conversion event is required.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": "Traffic",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta also maps the old Messages objective to Traffic when the conversion location is Messenger or WhatsApp.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "Recreate a campaign that used an original ad objective in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Ad goals in Ad Centre, Business Suite or Instagram, such as getting more website visitors, set the objective, conversion location and performance goal for you. In Ads Manager you choose these yourself.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "Match ad goals to Ads Manager campaign objectives",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Use it when your goal is to get people to a website, app, messaging thread, call or Instagram profile, and you have no conversion event set up or don't need one.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": "Traffic",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you need purchases or leads. Those goals sit under Sales and Leads, which use conversion locations and events. Traffic needs no conversion event, so it isn't set up to optimise for them.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": "(none)",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "Recreate a campaign that used an original ad objective in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not assume Traffic recreates old Store traffic campaigns. Meta maps Store traffic to Awareness with Store locations features, and only for Pages with store locations set up.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.campaign",
                "source_url": "https://www.facebook.com/business/help/1438417719786914",
                "locator": "Recreate a campaign that used an original ad objective in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "How to choose an ad objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Meta documents the objective choice and conversion location options only. It doesn't give the later menu paths, performance goal values or budget settings, so the steps stop there.",
        "status": "documented",
        "claims": [
          {
            "text": "In Ads Manager, create a new campaign and go to the campaign level, where the ad objective is set.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ads",
                "source_url": "https://www.facebook.com/business/help/621956575422138",
                "locator": "Campaign level in Meta Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create ad campaigns in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Select Traffic from the six objectives offered: Awareness, Traffic, Engagement, Leads, App promotion and Sales.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.image",
                "source_url": "https://www.facebook.com/business/ads-guide/update/image",
                "locator": "Choose an objective",
                "source_site": "Meta Business Help Centre",
                "source_title": "Image ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choose the conversion location where you want people to go: Website, App, Messenger, WhatsApp, Calls or Instagram profile.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": "Traffic",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Skip the conversion event. Traffic doesn't require one.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.conversion_locations",
                "source_url": "https://www.facebook.com/business/help/2035196646663270",
                "locator": "Traffic",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available conversion locations and events by objective in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Assess visits when you select Website as the Traffic conversion location. This setup does not require a conversion event, so assess any follow-on sale separately.",
            "status": "inferred",

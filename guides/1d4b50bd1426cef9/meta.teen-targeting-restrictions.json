{
  "schema_version": 1,
  "release": "1d4b50bd1426cef9",
  "guide": {
    "feature_id": "meta.teen-targeting-restrictions",
    "name": "Teen targeting restrictions",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.guide.teen_targeting.teen-ad-targeting-restrictions"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Meta automatically removes some audience and campaign options when your ads can reach people under 18 (older in some countries). The easy mistake is assuming a setup that works for adults will carry over unchanged to teens.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Some audience and campaign options are not available when you create ads that include people under 18 (or older in some countries) in your desired audience.",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta presents these limits as part of its teen privacy and safety efforts. They are set by the platform, not chosen by you.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Some audience and campaign options are not available when you create ads that include people under 18 (or older in some countries) in your desired audience.",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Worldwide, Meta publishes a list of audience options and a list of campaign options that are unavailable for showing ads to teens. Check Meta's page for the exact items, as they are not reproduced here.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Worldwide restrictions on advertising to teens",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Optimisation goals still available for teens: app installs, impressions, reach, daily unique reach, link clicks, off-site conversions and, for Instagram ads, More profile visits (set on Instagram, not in Ads Manager).",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Worldwide restrictions on advertising to teens",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Placements still available for teens: Facebook Feed, right column, Stories, in-stream video (mobile) and Reels; Instagram Feed, Explore, Stories and Reels; and WhatsApp Status.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Worldwide restrictions on advertising to teens",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta automatically adjusts the minimum audience age for all Advantage+ app campaigns, and these campaigns can't be used to reach teens.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Worldwide restrictions on advertising to teens",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Ads with locations in the EU, EEA or Switzerland can't deliver to people under 18. They keep delivering to people aged 18 or over. Further capabilities that would need teens' information for ads may also be unavailable.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Restrictions on advertising to teens in the EU, EEA and Switzerland",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you are planning a campaign whose audience could include under-18s outside the EU, EEA and Switzerland. Check the unavailable options list, then build around the goals and placements that remain open to teens.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Worldwide restrictions on advertising to teens",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when you want to reach teens in the EU, EEA or Switzerland. Ads with locations there can't deliver to under-18s at all.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Restrictions on advertising to teens in the EU, EEA and Switzerland",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on Advantage+ app campaigns to reach teens. Meta raises their minimum age automatically.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Worldwide restrictions on advertising to teens",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Meta documents only how to set an age limit in the ad set. It does not give a path for choosing teen-specific options, so this stops there.",
        "status": "documented",
        "claims": [
          {
            "text": "In Ads Manager, open the ad set and find Audience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ad_sets",
                "source_url": "https://www.facebook.com/business/help/151999381652364",
                "locator": "Limit age and gender targeting",
                "source_site": "Meta Business Help Centre",
                "source_title": "Set age targeting when creating an ad",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Select Further limit your audience (or Further limit the reach of your ads), then confirm in the popup.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ad_sets",
                "source_url": "https://www.facebook.com/business/help/151999381652364",
                "locator": "Limit age and gender targeting",
                "source_site": "Meta Business Help Centre",
                "source_title": "Set age targeting when creating an ad",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Select age and choose your range. In some setups, untick Use as a suggestion for each choice. Meta then won't target beyond your age setting.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ad_sets",
                "source_url": "https://www.facebook.com/business/help/151999381652364",
                "locator": "Limit age and gender targeting",
                "source_site": "Meta Business Help Centre",
                "source_title": "Set age targeting when creating an ad",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "By default, age and gender are only suggestions, so Meta may show ads beyond them. Minimum age is the exception and is an audience control.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.ad_sets",
                "source_url": "https://www.facebook.com/business/help/151999381652364",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Set age targeting when creating an ad",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Reach and impressions: if you plan within the remaining goals and placements, teen delivery stays possible. The trade-off is a narrower toolset than for adults, so scale may be lower.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Worldwide restrictions on advertising to teens",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Cost per result: if your usual goal or audience option is unavailable for teens, you may need a substitute goal such as link clicks. Results may then not be comparable with adult campaigns, so compare them cautiously.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.teen_targeting",
                "source_url": "https://www.facebook.com/business/help/229435355723442",
                "locator": "Worldwide restrictions on advertising to teens",
                "source_site": "Meta Business Help Centre",
                "source_title": "Advertising options to reach teens",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "relationships",
        "summary": "Only TikTok and Pinterest candidates touch age targeting, and neither is an equivalent. Meta's feature is a platform-enforced restriction.",
        "status": "inferred",
        "claims": []
      },

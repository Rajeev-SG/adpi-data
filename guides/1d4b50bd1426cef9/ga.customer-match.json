    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Customer Match lets you upload your own customer data to reach and re-engage those customers on Google surfaces. Easy to miss: it needs an uploaded list, and ads only reach people signed in to their Google account.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "About Customer Match",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It works across Search, the Shopping tab, Gmail, YouTube and Display, using your online and offline first-party data.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "About Customer Match",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "You upload a customer list data file of customer information. Google then targets ads to those customers and to other customers like them.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "applicable condition (prerequisite)",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Ads are shown only to users signed in to their Google account, so your list reach is limited to people who are signed in when they browse.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "applicable condition (eligibility)",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "On Search and the Shopping tab you can adjust bids based on what you know about your customers' activities.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "About Customer Match",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Third-party ad serving creatives aren't supported with Customer Match.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "applicable condition (other)",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you hold first-party customer data and want to re-engage existing customers, or reach similar people, on Search, Shopping, Gmail, YouTube or Display.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "About Customer Match",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your creatives are served through a third-party ad server, which Customer Match doesn't support.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "applicable condition (other)",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it for full list reach: only signed-in users see the ads, and iOS 14 traffic may be affected, so expect fluctuation in web conversion performance.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "Recent updates to Customer Match",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it for EEA partner-exchange inventory: since early March 2024, lists activated there (including UK and Switzerland) are no longer available for web and app.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "About Customer Match",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Google Ads documents the prerequisites and the recommended upload route, but not the exact menu path or field names, so the steps stop there.",
        "status": "documented",
        "claims": [
          {
            "text": "Prepare a customer list data file of your customer information.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "applicable condition (prerequisite)",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Upload the list using Data Manager or the Data Manager API, which Google recommends over the Google Ads API for new integrations.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "About Customer Match",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "If an upload partner handles data for EEA users, confirm with them that the required consent signals are passed to Google.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "EU user consent policy for Customer Match upload partners",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Conversion rate or CPA: if your list holds high-value customers, bidding up on them in Search and Shopping may lift conversion rate. The trade-off is a smaller audience and higher CPCs, and only signed-in users are reachable.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",
                "locator": "About Customer Match",
                "source_site": "Google Ads Help",
                "source_title": "About Customer Match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Reach among new prospects: because ads also target customers like your list, you may gain incremental reach on YouTube, Gmail and Display. Quality depends on your seed list, and attributed results are not proof of incrementality.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "google.customer_match",
                "source_url": "https://support.google.com/google-ads/answer/6379332?hl=en",

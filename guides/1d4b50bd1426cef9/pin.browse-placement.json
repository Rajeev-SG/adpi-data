                "source_site": "Pinterest Help Centre",
                "source_title": "Ad placements",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It is one of three ad group placement options on Pinterest: Browse, Search, or All (both).",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.placements",
                "source_url": "https://help.pinterest.com/en-gb/business/article/placement",
                "locator": "Placement options list",
                "source_site": "Pinterest Help Centre",
                "source_title": "Ad placements",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Pinterest recommends targeting all placements by default to maximise reach, and notes All is the default ad group setting.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.placements",
                "source_url": "https://help.pinterest.com/en-gb/business/article/placement",
                "locator": "Note on default placement",
                "source_site": "Pinterest Help Centre",
                "source_title": "Ad placements",
                "raw_sha256": null,

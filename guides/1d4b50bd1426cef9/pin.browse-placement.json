    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Browse placement shows your Pinterest ads while people browse their home feeds and related Pins.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.placements",
                "source_url": "https://help.pinterest.com/en-gb/business/article/placement",

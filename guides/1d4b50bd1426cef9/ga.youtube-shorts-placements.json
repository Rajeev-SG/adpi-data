                "source_title": "Demand Gen channel controls",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Channel controls also provide performance breakdowns by channel, which supports optimization decisions.",
            "status": "documented",
            "evidence": [

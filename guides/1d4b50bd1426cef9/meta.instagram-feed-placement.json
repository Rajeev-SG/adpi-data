    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Instagram Feed is a placement you choose for where Meta shows your ad, including video ads. It is a delivery location, not a creative format, so check that your objective supports Instagram before you plan around it.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.video",
                "source_url": "https://www.facebook.com/business/ads-guide/update/video",
                "locator": "Choose your ad placement: \"Instagram feed\"",
                "source_site": "Meta Business Help Centre",
                "source_title": "Video ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              },
              {
                "source_id": "meta.guide.instagram",
                "source_url": "https://www.facebook.com/business/help/1513393428972189",
                "locator": "Select Instagram as an ad placement in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram ads in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta lists Instagram Feed separately from Instagram Stories, Explore home and Reels, so each is a distinct placement option.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.video",
                "source_url": "https://www.facebook.com/business/ads-guide/update/video",
                "locator": "Choose a placement",
                "source_site": "Meta Business Help Centre",
                "source_title": "Video ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "You choose placements in the Placements section when you build the ad set. Meta recommends including all available placements so ads run across several Meta platforms, Instagram among them.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instagram",
                "source_url": "https://www.facebook.com/business/help/1513393428972189",
                "locator": "Select Instagram as an ad placement in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram ads in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choosing Instagram under Platforms limits delivery to Instagram. Advantage+ may show as On in the Audience and Placements sections.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instagram",
                "source_url": "https://www.facebook.com/business/help/1513393428972189",
                "locator": "Select Instagram as an ad placement in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram ads in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Meta publishes a placement-by-format table that shows which ad formats each placement supports. Instagram Explore home, for example, only supports a 1:1 aspect ratio.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.placement_objectives",
                "source_url": "https://www.facebook.com/business/help/279271845888065",
                "locator": "Feeds",
                "source_site": "Meta Business Help Centre",
                "source_title": "Available ad placements for marketing objectives",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Use it when your video creative is built for the Instagram feed and you want to control or review Instagram delivery separately from other Meta surfaces.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.ads.guide.video",
                "source_url": "https://www.facebook.com/business/ads-guide/update/video",
                "locator": "Choose your ad placement: \"Instagram feed\"",
                "source_site": "Meta Business Help Centre",
                "source_title": "Video ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your chosen objective does not support Instagram as a placement, or when you expect Feed alone to carry delivery. Meta recommends all available placements for best value.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instagram",
                "source_url": "https://www.facebook.com/business/help/1513393428972189",
                "locator": "Select Instagram as an ad placement in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram ads in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Meta documents selecting Instagram as a platform in Ads Manager. It does not document a way to select Instagram Feed alone, so the steps stop there.",
        "status": "documented",
        "claims": [
          {
            "text": "Go to Meta Ads Manager and click Create.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instagram",
                "source_url": "https://www.facebook.com/business/help/1513393428972189",
                "locator": "Select Instagram as an ad placement in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram ads in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Choose an objective that supports Instagram as a placement, then click Continue.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instagram",
                "source_url": "https://www.facebook.com/business/help/1513393428972189",
                "locator": "Select Instagram as an ad placement in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram ads in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Set your budget, schedule and audience. In Placements, select Show more settings.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instagram",
                "source_url": "https://www.facebook.com/business/help/1513393428972189",
                "locator": "Select Instagram as an ad placement in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram ads in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Under Platforms, select Instagram to show ads only on Instagram, or keep all available placements, which Meta recommends. Then click Next.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instagram",
                "source_url": "https://www.facebook.com/business/help/1513393428972189",
                "locator": "Select Instagram as an ad placement in Ads Manager",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create Instagram ads in Meta Ads Manager",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]

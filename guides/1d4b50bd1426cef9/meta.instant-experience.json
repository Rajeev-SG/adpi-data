  "guide": {
    "feature_id": "meta.instant-experience",
    "name": "Instant Experience",
    "vendor": "Meta",
    "platform": "Paid Social",
    "capability_ids": [
      "meta.ads.guide.collection.instant-experience-landing-page"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Instant Experience is the full-screen mobile landing page that opens when someone taps a collection ad. It replaces an external page as the destination, so you build it inside Meta rather than send people to your site.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Collection",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It was previously known as Canvas. It is an immersive full-screen format for mobile devices, and on Instagram it is supported in both stories and feed.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instant_experience",
                "source_url": "https://www.facebook.com/business/help/135270243759813",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create an Instant Experience for ads on Instagram",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It is a destination and creative format, not a targeting or bidding control. It does not steer who sees the ad.",
            "status": "inferred",
            "evidence": [],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "A collection ad shows a cover image or video followed by three product images in Facebook Feed. Tapping it opens the Instant Experience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Collection",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "You can build the page from the Storefront, Lookbook or Customer Acquisition templates, or create a custom Instant Experience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Collection",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The cover image or video in the collection ad uses the first media asset from your Instant Experience, so the order of your assets affects the ad itself.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Collection",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "A custom build lets you choose the components and how they fit a mobile screen.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instant_experience",
                "source_url": "https://www.facebook.com/business/help/135270243759813",
                "locator": "Create an Instant Experience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create an Instant Experience for ads on Instagram",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Use it when you run collection ads and want people to browse and buy products in a visual, mobile-first page without leaving the app.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Collection",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "For collection ads, an Instant Experience is required. You cannot run the format without one.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.ads.guide.collection",
                "source_url": "https://www.facebook.com/business/ads-guide/update/collection",
                "locator": "Collection",
                "source_site": "Meta Business Help Centre",
                "source_title": "Collection ad specifications",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on Instant Experience to send people straight to a website. This ad destination first opens a full-screen experience within the app.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "meta.guide.instant_experience",
                "source_url": "https://www.facebook.com/business/help/135270243759813",
                "locator": null,
                "source_site": "Meta Business Help Centre",
                "source_title": "Create an Instant Experience for ads on Instagram",
                "raw_sha256": "4c2655adda1be9fbf2574657d43401843b5c7c153e643f0c961796177cb50704",
                "cleaned_sha256": "5a7425a6cae8ce064df0b9e4ea784553d277c157702cce056958bbfa9b8192ba"
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "Meta is rolling out a new Ad setup and Ad creative experience, so labels and placement can differ in your account. The steps below follow the documented path and stop at Finish.",
        "status": "documented",
        "claims": [
          {
            "text": "1. In Ads Manager, open the ad you are editing and go to Ad format. Select Collection. If it is not shown in Ad setup, click More options, or pick it in Ad creative under Format display options.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instant_experience",
                "source_url": "https://www.facebook.com/business/help/135270243759813",
                "locator": "Create an Instant Experience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create an Instant Experience for ads on Instagram",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "2. In the Destination section, select Instant Experience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instant_experience",
                "source_url": "https://www.facebook.com/business/help/135270243759813",
                "locator": "Create an Instant Experience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create an Instant Experience for ads on Instagram",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "3. Click Create new to build a template, or search for an existing Instant Experience.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instant_experience",
                "source_url": "https://www.facebook.com/business/help/135270243759813",
                "locator": "Create an Instant Experience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create an Instant Experience for ads on Instagram",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "4. For a custom build, name it, select the components to add and how they fit a mobile screen, then select Save.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instant_experience",
                "source_url": "https://www.facebook.com/business/help/135270243759813",
                "locator": "Create an Instant Experience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create an Instant Experience for ads on Instagram",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "5. Select Finish.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.guide.instant_experience",
                "source_url": "https://www.facebook.com/business/help/135270243759813",
                "locator": "Create an Instant Experience",
                "source_site": "Meta Business Help Centre",
                "source_title": "Create an Instant Experience for ads on Instagram",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {

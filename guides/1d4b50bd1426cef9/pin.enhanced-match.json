  "guide": {
    "feature_id": "pin.enhanced-match",
    "name": "Enhanced match",
    "vendor": "Pinterest",
    "platform": "Paid Media",
    "capability_ids": [
      "pinterest.measurement.tag.enhanced_match.enhanced-match"
    ],
    "sections": [
      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Enhanced match is an optional addition to the Pinterest tag that matches conversion data with the person responsible for the conversion.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It sends hashed email addresses to Pinterest to match site events when there is no Pinterest cookie present.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It enables cross-device checkout tracking, which cannot be done otherwise.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "mechanism",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "The tag transmits a hashed email address to Pinterest, which checks whether it is associated with an existing Pinterest account for matching.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "The JavaScript tag hashes un-hashed email addresses in the browser using SHA-256 before sending them, and data is transmitted over HTTPS.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Pinterest deletes the email address value after completing the matching process, and matched addresses are only used to match conversions to Pinterest activity.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "An external ID (a unique ID identifying a single user) can also be sent alongside conversions, on tag load or via set.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "use_cases",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Use it when you want conversions reported in Ads Manager to reflect checkouts completed on other devices, where no Pinterest cookie is present.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Do not rely on it when your audience is unlikely to be logged in to Pinterest with an email address you can pass, since matching depends on the hashed email being associated with an existing Pinterest account.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "setup",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "Enroll the feature: log in to your Pinterest business account, click the hamburger icon at the top-left, under Manage business click Conversions, click Event quality on the left, click the chevron-down next to Show more product features, then click Enroll this feature next to Enhanced match.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In the JavaScript part of the tag, add the em parameter with the email address to the pintrk('load') function in the base code; event codes do not need modification.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "In the <img> (noscript) part of the tag, you must hash the email yourself using SHA-256, SHA-1 or MD5, lowercase with spaces removed, and add it to every <img> tag URL (base code and event code) via the &pd[em]= parameter.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Optionally send an external ID via pintrk('load') or pintrk('set') alongside your track calls.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "After setup, verify the Pinterest tag to make sure everything works.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Pinterest Tag is not available in all regions; the help page notes some viewers may be in a region where it is not yet available.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]
      },
      {
        "kind": "kpis",
        "summary": "",
        "status": "inferred",
        "claims": [
          {
            "text": "Because enhanced match attributes conversions when no Pinterest cookie is present, the share of conversions reported in Ads Manager that were previously missed (cookieless/cross-device conversions) is a useful metric to watch; the causal path is conditional on the hashed email matching an existing Pinterest account, and the trade-off is that you are passing user email data to Pinterest for matching.",
            "status": "inferred",
            "evidence": [
              {
                "source_id": "pinterest.measurement.tag.enhanced_match",
                "source_url": "https://help.pinterest.com/en/business/article/enhanced-match",
                "locator": null,
                "source_site": "Pinterest Help Centre",
                "source_title": "Enable optional enhanced match",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          }
        ]

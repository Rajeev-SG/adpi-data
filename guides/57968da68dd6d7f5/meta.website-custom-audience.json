      {
        "kind": "definition",
        "summary": "",
        "status": "documented",
        "claims": [
          {
            "text": "A website custom audience is a custom audience built from people who visited the advertiser's website, using standard or custom events tracked by the Meta pixel.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.custom_audiences.website",
                "source_url": "https://www.facebook.com/business/help/666509013483225",
                "locator": "Heading 'Create a website custom audience'",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "Its stated purpose is to retarget website visitors who did not complete a desired action, such as a purchase.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.custom_audiences.website",
                "source_url": "https://www.facebook.com/business/help/666509013483225",
                "locator": "Heading 'Create a website custom audience'",
                "raw_sha256": null,
                "cleaned_sha256": null
              }
            ],
            "conditions": []
          },
          {
            "text": "It is created in Ads Manager by choosing the Website source.",
            "status": "documented",
            "evidence": [
              {
                "source_id": "meta.custom_audiences.website",
                "source_url": "https://www.facebook.com/business/help/666509013483225",
                "locator": "Heading 'Create a website custom audience'",
